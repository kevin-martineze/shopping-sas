# Supabase: solo Storage, para las fotos de prendas y colecciones. Los datos viven en la API.
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Solo servidor. NUNCA exponer al cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# URL pública del sitio, usada en enlaces del mensaje de WhatsApp y en el sitemap.
PUBLIC_SITE_URL="http://localhost:5173"

# API propia (ecommerce-api) con su prefijo de versión. Solo se llama desde el servidor.
# 127.0.0.1 y no localhost: Node puede resolver localhost a IPv6 y la API escucha en IPv4.
API_URL="http://127.0.0.1:3000/v1"

# Tienda que sirve este frontend: su slug en la API.
STORE_SLUG="mi-tienda"

# Cifra la cookie de sesión del panel. Mínimo 32 caracteres; cambiarlo cierra todas
# las sesiones abiertas. Genera uno con: openssl rand -base64 48
SESSION_SECRET="..."

# Opcional: origen de `pnpm db:import-supabase` en la API. Usa la URL del pooler
# (aws-0-<región>.pooler.supabase.com, usuario postgres.<ref>): la conexión directa es solo IPv6.
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres"
