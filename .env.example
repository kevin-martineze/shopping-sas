# Supabase — proyecto de la tienda
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="ey..."

# Solo servidor. NUNCA exponer al cliente ni commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# URL pública del sitio, usada en enlaces del mensaje de WhatsApp y en el sitemap.
PUBLIC_SITE_URL="http://localhost:5173"

# Opcional: solo para correr migraciones desde la terminal (supabase db push / psql).
# La aplicación no la usa; habla con Supabase por HTTPS con las claves de arriba.
# Project Settings > Database > Connection string, con tu contraseña.
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
