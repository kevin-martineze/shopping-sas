# URL pública del sitio, usada en enlaces del mensaje de WhatsApp y en el sitemap.
PUBLIC_SITE_URL="http://localhost:5173"

# API propia (ecommerce-api) con su prefijo de versión. Solo se llama desde el servidor.
# 127.0.0.1 y no localhost: Node puede resolver localhost a IPv6 y la API escucha en IPv4.
API_URL="http://127.0.0.1:3000/v1"

# Multitienda: cada tienda es un subdominio de STORE_ROOT_DOMAIN (con puerto si lo hay).
# En local, `boutique.localhost:5173` sirve la tienda `boutique` sin tocar /etc/hosts.
# Sin él, el frontend sirve solo a STORE_SLUG en cualquier host.
PUBLIC_STORE_ROOT_DOMAIN="localhost:5173"

# Tienda del dominio raíz. Sin ella, el dominio raíz muestra el sitio comercial.
PUBLIC_STORE_SLUG="mi-tienda"

# Tienda de ejemplo que el sitio comercial enseña ("Ver una tienda"). Sin ella
# no se ofrece: un enlace a una demo que no existe es peor que no tener demo.
PUBLIC_DEMO_STORE_SLUG=

# El mismo API_SHARED_SECRET de la API: sin él, la API de producción responde 403.
# Vacío en desarrollo. Genera uno con: openssl rand -base64 48
API_SHARED_SECRET=""

# Cifra la cookie de sesión del panel. Mínimo 32 caracteres; cambiarlo cierra todas
# las sesiones abiertas. Genera uno con: openssl rand -base64 48
SESSION_SECRET="..."

# Solo para migrar desde la tienda con Supabase (`pnpm db:import-supabase` y
# `pnpm db:import-supabase-media` en la API). Usa la URL del pooler
# (aws-0-<región>.pooler.supabase.com, usuario postgres.<ref>): la conexión directa es solo IPv6.
SUPABASE_DB_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres"
